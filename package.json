{
  "name": "p2party-server",
  "version": "0.1.0",
  "description": "Protocol-v3 signaling server for p2party WebRTC room meshes",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/p2party/p2party-server.git"
  },
  "bugs": {
    "url": "https://github.com/p2party/p2party-server/issues"
  },
  "homepage": "https://github.com/p2party/p2party-server#readme",
  "module": "src/index.ts",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "defu": "6.1.7",
    "effect": "3.22.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun test",
    "format": "bun prettier . --write",
    "format:check": "bun prettier . --check",
    "build:linux": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-x64-modern --format esm ./src/index.ts --outfile p2party_linux_x64",
    "build:linux:arm64": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-arm64 --format esm ./src/index.ts --outfile p2party_linux_arm64",
    "build:macos": "bun build --compile --minify --sourcemap --target=bun-darwin-arm64 --format esm ./src/index.ts --outfile p2party_macos",
    "build:windows": "bun build --compile --minify --sourcemap --bytecode --target=bun-windows-x64-modern --format esm ./src/index.ts --outfile p2party_exe"
  },
  "dependencies": {
    "@ondemos/core": "0.2.7",
    "@prisma/client": "6.19.2",
    "class-validator": "0.15.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.9.6",
    "prisma": "6.19.2",
    "typescript": "^5.9.3"
  }
}
