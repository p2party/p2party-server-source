# ============================================================================
# Encrypted variables — copy to vault.yml and encrypt with ansible-vault
# ============================================================================
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml --vault-password-file ./vault_pass.sh
#
# vault.yml is gitignored: never commit the encrypted file's plaintext, and
# never add real values to this example.
#
# These names are load-bearing. Ansible fails a template render on an undefined
# variable, so a typo here surfaces as a deploy failure, not a silent default.
# Regenerate the list with:
#   grep -rhoE "vault_[a-z0-9_]+" playbooks/ templates/ | sort -u
# ============================================================================

# ---- coturn ----------------------------------------------------------------
# Shared secret for coturn's time-limited REST credentials. The signaling
# server reads the same value as COTURN_SECRET and REFUSES TO START if it is
# shorter than 32 bytes (src/utils/socketAuth.ts assertSecureTurnSecret).
# Generate with: openssl rand -hex 32
vault_coturn_auth_secret: "replace-me-with-64-hex-characters"

# The TURN realm. This must equal the DNS name the certificate is issued for,
# because setup-coturn.yml passes it to certbot as the -d argument and reads
# the cert back from /etc/letsencrypt/live/<realm>/.
vault_coturn_realm: "turn.example.com"

# Contact address for the Let's Encrypt account.
vault_admin_email: "admin@example.com"

# ---- postgres --------------------------------------------------------------
# Used by install-postgres.yml and by the signaling server's PostgreSQL
# DATABASE_URL. Keep these values aligned with the deployed database host.
vault_postgres_user: "p2party"
vault_postgres_password: "replace-me"
vault_postgres_db_name: "p2party"

# ---- wireguard -------------------------------------------------------------
# Server private key: wg genkey
vault_wireguard_private_key: "replace-me"
# List of peers; each needs at least public_key and allowed_ips.
vault_wireguard_peers: []
