# ============================================================================
# P2Party Production Inventory
# ============================================================================
# 3 servers accessed via SSH to private network IPs.
#
# Copy to inventory/production.yml and fill in every CHANGEME value.
# The real inventory is gitignored: it names the VPN entry point, the
# non-standard SSH ports, and the operator's key, none of which belong
# in a public repository.
#
# Usage: ansible-playbook -i inventory/production.yml playbooks/deploy.yml
# ============================================================================

all:
  children:
    # ========================================================================
    # Production Environment Group
    # ========================================================================
    production:
      children:
        databases_production:
        turn_production:
        signaling_production:
        wireguard_production:

    # ========================================================================
    # PostgreSQL Database Server
    # ========================================================================
    databases_production:
      hosts:
        p2party-postgres:
          ansible_host: 10.231.0.2
          ansible_port: CHANGEME_SSH_PORT
          ansible_user: p2party
          role: database
          service: postgres
          # PostgreSQL 17 tuning (4GB RAM / 3 CPU)
          pg_max_connections: 100
          pg_shared_buffers: 1GB
          pg_effective_cache_size: 3GB
          pg_maintenance_work_mem: 256MB
          pg_work_mem: 16MB

    # ========================================================================
    # Coturn TURN/STUN Server (turn.p2party.com)
    # ========================================================================
    turn_production:
      hosts:
        p2party-coturn:
          ansible_host: 10.231.0.3
          ansible_port: CHANGEME_SSH_PORT
          ansible_user: p2party
          role: turn
          service: coturn

    # ========================================================================
    # Signaling Server + Caddy (signaling.p2party.com)
    # ========================================================================
    signaling_production:
      hosts:
        p2party-signaling:
          ansible_host: 10.231.0.4
          ansible_port: CHANGEME_SSH_PORT
          ansible_user: p2party
          role: signaling
          service: server
          app_port: 3001

    # ========================================================================
    # WireGuard Server (vpn.p2party.com)
    # ========================================================================
    wireguard_production:
      hosts:
        p2party-wireguard:
          # Use public IP for WireGuard server since it's the VPN entry point
          ansible_host: CHANGEME.vpn.public.ip
          ansible_port: CHANGEME_SSH_PORT
          ansible_user: p2party
          role: wireguard
          service: vpn
          # Private IP for reference (accessible from other servers)
          private_ip: 10.231.0.5

    # ========================================================================
    # Grouped by function
    # ========================================================================
    databases:
      children:
        databases_production:

    applications:
      children:
        signaling_production:

    private_network:
      children:
        databases_production:
        turn_production:
        signaling_production:
        wireguard_production:

    p2party:
      children:
        databases_production:
        turn_production:
        signaling_production:
        wireguard_production:

  # ==========================================================================
  # Global Variables
  # ==========================================================================
  vars:
    ansible_python_interpreter: /usr/bin/python3
    ansible_become: true
    ansible_become_method: sudo

    # Domain configuration
    domain: p2party.com
    signaling_domain: signaling.p2party.com
    turn_domain: turn.p2party.com
    stun_domain: stun.p2party.com

    # Network configuration
    private_network: 10.231.0.0/24

    # Application configuration
    app_user: p2party
    app_base_dir: /home/p2party

    # SSH configuration
    ssh_key_path: ~/.ssh/CHANGEME_ed25519
