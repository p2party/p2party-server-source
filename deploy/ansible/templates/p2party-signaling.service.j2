# ============================================================================
# P2Party Signaling Server - systemd service
# ============================================================================
# Managed by Ansible - do not edit manually
# ============================================================================

[Unit]
Description=P2Party Signaling Server
StartLimitIntervalSec=0
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{ app.user }}
Group={{ app.group }}
WorkingDirectory={{ app.home }}/server
EnvironmentFile={{ app.home }}/server/.env
# After EnvironmentFile on purpose: systemd applies these in order and the last
# assignment wins, so this cannot be clobbered by a PORT in the shared file.
Environment=PORT={{ signaling_port }}
ExecStart={{ app.home }}/server/p2party-server
Restart=always
RestartSec={{ signaling_restart_seconds }}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=p2party-signaling-{{ signaling_port }}

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ app.home }}/server
PrivateTmp=true

[Install]
WantedBy=multi-user.target
