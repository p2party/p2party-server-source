# ============================================================================
# P2Party Coturn TURN/STUN Server Configuration
# ============================================================================
# Managed by Ansible - do not edit manually
# ============================================================================

# ---- General ----
listening-port=3478
tls-listening-port=443
alt-listening-port=0
alt-tls-listening-port=0

# ---- Network ----
# Do not set listening-ip: coturn listens on all IPv4 and IPv6 by default
# Do not set relay-ip: coturn auto-detects relay addresses
# Do not set external-ip: this host owns its public addresses directly rather
# than through NAT. Coturn then advertises the relay address matching the
# allocation family. A bare external-ip is single-valued, so emitting separate
# bare IPv4 and IPv6 directives silently misadvertises one family.
min-port=49152
max-port=65535

# ---- TLS ----
cert=/etc/coturn/fullchain.pem
pkey=/etc/coturn/privkey.pem
# TLS 1.0/1.1 are disabled below. Restrict the 1.2 suites to forward-secret
# AEAD only; TLS 1.3 negotiates its own suites and ignores this list.
cipher-list="ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!eNULL:!MD5:!DSS:!SHA1"
ec-curve-name=prime256v1

# ---- Authentication ----
# Time-limited REST credentials (RFC 7635 style): the signaling server derives
# username=<expiry>:<tag> and password=HMAC-SHA1(secret, username), so no
# long-lived credential is ever handed to a browser. The tag is an HMAC of the
# identity key and expiry under the same secret; the key itself never appears.
# The expiry is rounded up to a whole credential lifetime (one hour), so one
# identity gets one username per lifetime. coturn checks the expiry only on a
# session's first request (see Quotas), so a refreshed allocation outlives it.
use-auth-secret
static-auth-secret={{ vault_coturn_auth_secret }}
realm={{ vault_coturn_realm }}

# ---- Quotas ----
# Without these a TURN server is an unmetered bandwidth amplifier billed to
# whoever runs it: any client that can obtain a credential can relay traffic at
# line rate, and a leaked secret becomes an open relay with no ceiling.
# total-quota is concurrent allocations server-wide, user-quota per username.
# Both bandwidth settings are bytes/sec, with input and output counted separately.
# Clients without a BANDWIDTH request reserve max-bps per allocation: the default
# aggregate budget admits 48 such allocations. Raise it for larger rooms.
# coturn counts user-quota per username, the part after "<digits>:", here the
# hourly tag (get_real_username and check_new_allocation_quota in
# src/apps/relay/userdb.c). It checks a username's expiry only on a session's
# first request: check_stun_auth in src/server/ns_turn_server.c looks the key
# up, and so checks the expiry, only while the session has none cached; Refresh,
# CreatePermission and ChannelBind are not re-checked (coturn 4.6.1 and master
# 44fa529, read November 2026). One username reserves at most user-quota *
# max-bps (12 * 625000 = 7500000 of 30000000 at the defaults), which
# setup-coturn.yml keeps to half of bps-capacity. One identity holds at most
# three tags' quota at once if it stops refreshing, and gains one more tag's
# quota every lifetime for as long as it keeps refreshing its old allocations.
# The quota guards against one client's runaway use; it is not a bound on an
# adversary, who can also simply use several identities (four full quotas
# reserve the whole relay at the defaults). total-quota and bps-capacity are
# the only hard limits.
total-quota={{ coturn_total_quota | default(1200) }}
user-quota={{ coturn_user_quota | default(12) }}
max-bps={{ coturn_max_bps | default(625000) }}
bps-capacity={{ coturn_bps_capacity | default(30000000) }}

# ---- Logging ----
# No log is kept. At its default verbosity coturn logs each session's username
# beside the client address, and whoever holds the secret can link a username
# to its identity key. Nothing goes to stdout, so nothing reaches journald
# either. simple-log keeps coturn from appending a date to the file name. For a
# one-off diagnosis, run turnserver by hand with --log-file=stdout.
log-file=/dev/null
simple-log
no-stdout-log

# ---- Security ----
fingerprint
no-cli
no-software-attribute
no-multicast-peers
no-loopback-peers
no-tlsv1
no-tlsv1_1
# Refuse RFC 6062 TCP relay allocations. Browsers use TURN-over-TCP/TLS for the
# client-to-server leg only and never request a TCP allocation, so this costs
# nothing for WebRTC — and it lets the cloud firewall hold outbound TCP to the
# baseline instead of opening it to the whole internet.
no-tcp-relay

# Deny private/special IP ranges for relay
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255

# IPv6 private/special ranges
denied-peer-ip=::1
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=::ffff:0:0-::ffff:ffff:ffff
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=2001:db8::-2001:db8:ffff:ffff:ffff:ffff:ffff:ffff

# ---- Performance ----
# An allocation that is not refreshed is released at most this many seconds
# after its last Allocate or Refresh, instead of coturn's default 3600. WebRTC
# clients normally take the 600 s default lifetime and refresh before it ends.
max-allocate-lifetime={{ coturn_max_allocate_lifetime | default(600) }}
stale-nonce=600
channel-lifetime=600
permission-lifetime=300
