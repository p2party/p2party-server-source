# ============================================================================
# P2Party Signaling Server Environment
# ============================================================================
# Managed by Ansible - do not edit manually.
#
# Every name here is read by the server. Keep this file in step with
#   grep -rhoE "process\.env\.[A-Z0-9_]+" src
# A variable spelled differently from what the code reads is silently ignored.
# ============================================================================

# PORT is deliberately absent. It differs per instance, and this file is shared
# by all of them — defining it here made every unit bind 3001 and all but the
# first died with EADDRINUSE. The systemd unit sets it, after this file is read.

# src/index.ts -> assertSecureTurnSecret(): if this is set, it must be at least
# 32 bytes or the process REFUSES TO START. Unset, the server starts and issues
# no TURN credentials at all, leaving every client STUN-only. Note the prefix —
# the server reads COTURN_SECRET, not TURN_SECRET.
COTURN_SECRET={{ vault_coturn_auth_secret }}

# Relay endpoints handed to clients alongside their short-lived credentials.
# Without these the server issues no credentials at all and clients stay
# STUN-only, which fails behind symmetric NAT and carrier-grade NAT.
# TLS on 443 first: it is the port most likely to survive a restrictive
# network. The UDP endpoint follows for lower latency where it is reachable.
COTURN_URLS=turns:{{ domains.turn }}:{{ ports.coturn }}?transport=tcp,turn:{{ domains.turn }}:{{ ports.coturn_stun }}

# prisma/schema.prisma declares `provider = "postgresql"`. Prisma validates the
# URL scheme at startup, so a file: URL here fails immediately and loudly.
# The Postgres host is reachable only over the private network; its firewall
# allows 5432 from 10.231.0.0/24 only.
DATABASE_URL=postgresql://{{ database.user }}:{{ database.password }}@{{ database.host }}:{{ database.port }}/{{ database.name }}?schema=public&sslmode={{ database.ssl_mode }}&connection_limit={{ database.connection_limit }}
