# ============================================================================
# P2Party Signaling Server Environment
# ============================================================================
# Managed by Ansible - do not edit manually.
#
# Every name here is read by the server. Keep this file in step with
#   grep -rhoE "process\.env\.[A-Z0-9_]+" src
# A variable spelled differently from what the code reads is silently ignored,
# except COTURN_SECRET, whose absence aborts startup.
# ============================================================================

# src/index.ts:12-16 — optional, defaults to 3001. Caddy reverse-proxies here.
PORT={{ app_port | default(3001) }}

# src/index.ts:17 -> assertSecureTurnSecret(): the process REFUSES TO START
# unless this is present and at least 32 bytes. Note the prefix — the server
# reads COTURN_SECRET, not TURN_SECRET.
COTURN_SECRET={{ vault_coturn_auth_secret }}

# prisma/schema.prisma declares `provider = "sqlite"`, so this must be a file:
# URL. A postgresql:// URL is accepted here and then fails at query time.
DATABASE_URL=file:{{ app.home }}/server/prisma/production.db
