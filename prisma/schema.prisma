// Prisma schema for the p2party signaling server.
//
// Postgres, not SQLite. Signaling is the one component that must tolerate more
// than one process: a SQLite file cannot be shared across instances, and
// `PendingSignal` below exists so two instances can hand signals to each other.
// See src/pubsub.ts.

generator client {
  // The `prisma-client` generator (not `prisma-client-js`) emits ESM into the
  // source tree, so `bun build --compile` can statically resolve and embed it.
  // The legacy generator is reached through a runtime require() of a bare
  // specifier, which the bundler cannot see — the compiled binary then dies with
  // "Cannot find module '@prisma/client' from '/$bunfs/root/...'", because
  // there is no node_modules inside the binary's virtual filesystem.
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  // Prisma 7 moved the connection URL out of the schema; it is supplied by
  // prisma.config.ts for CLI work (migrate, generate) and by the pg driver
  // adapter at runtime. See src/prismaClient.ts.
  provider = "postgresql"
}

model Peer {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastPing  BigInt
  publicKey String   @unique

  /// Which signaling instance currently holds this peer's socket. Null when the
  /// peer is not connected. Used to route a signal to the right process.
  serverId         String? @db.VarChar(36)
  /// Which socket of that instance holds the claim: its socket generation.
  /// Together with serverId it is the claim's owner token, so a socket can
  /// release or restore only a claim it wrote itself.
  socketGeneration String? @db.VarChar(36)

  challenges Challenge[]
  rooms      Room[]      @relation("PeerRooms")

  @@index([serverId])
  // lastPing holds the epoch milliseconds of the last authenticated login.
  @@index([lastPing, id])
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  identifier String   @unique @db.VarChar(128)

  peers Peer[] @relation("PeerRooms")
}

model Challenge {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nonce     String   @unique @db.VarChar(64)
  signature String?  @unique
  peerId    String   @db.Uuid

  /// Cascade: a deleted peer's challenges are meaningless, and leaving them
  /// would pin the unique nonce and signature forever.
  peer Peer @relation(fields: [peerId], references: [id], onDelete: Cascade)
}

/// A signal produced on one instance for a peer whose socket lives on another.
/// The producer writes the row and issues NOTIFY "server_<targetServerId>"; the
/// owner drains and deletes. These rows are transient routing state, not history:
/// the age sweep (src/pubsub.ts) deletes any row older than 120 seconds through
/// the createdAt index.
model PendingSignal {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now())
  targetServerId String   @db.VarChar(36)
  targetPeerId   String   @db.Uuid
  /// "frame": a serialized frame for the target's socket. "evict": an order
  /// to close the target's socket whose generation is the payload, because a
  /// newer session on another instance replaced it.
  kind           String   @default("frame") @db.VarChar(16)
  payload        String

  @@index([targetServerId])
  @@index([createdAt])
}
