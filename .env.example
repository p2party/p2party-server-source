# Required by Prisma. Paths are relative to prisma/schema.prisma, so this local
# SQLite example resolves to prisma/dev.db and does not contact Postgres.
DATABASE_URL="file:./dev.db"

# Optional; defaults to 3001.
PORT=3001

# Optional. Leave unset to disable TURN credential issuance. When set, use at
# least 32 bytes of cryptographically random material.
# COTURN_SECRET=replace-with-a-long-random-secret
