# Required by Prisma. The provider is postgresql (prisma/schema.prisma), so a
# file: URL is rejected at startup. For local work, point this at a throwaway
# Postgres — for example one started with:
#   docker run --rm -e POSTGRES_PASSWORD=password -e POSTGRES_USER=p2party \
#     -e POSTGRES_DB=p2party -p 5432:5432 postgres:17
DATABASE_URL="postgresql://p2party:password@localhost:5432/p2party?schema=public&sslmode=disable"

# Optional; defaults to 3001.
PORT=3001

# Required. Public WebSocket URL.host, including any non-default port.
SIGNALING_HOST=localhost:3001

# Optional pair. Leave either unset to disable TURN credential issuance. When
# set, use at least 32 bytes of cryptographically random secret material and
# provide one or more comma-separated turn:/turns: relay URLs.
# COTURN_SECRET=replace-with-a-long-random-secret
# COTURN_URLS=turns:turn.example.com:443?transport=tcp

# Optional native transfer validator. See src/ledger/README.md for the genesis schema.
# LEDGER_ENABLED=false
# LEDGER_CHAIN_ID=
# LEDGER_GENESIS_FILE=
# LEDGER_VERIFIER=
# LEDGER_CORS_ORIGINS=https://your-testnet-client.example
# SIGNALING_BIND_HOST=127.0.0.1

# Days since the last authenticated login before offline memberships expire.
MEMBERSHIP_TTL_DAYS=90
